{
  "namespace": "com.sentinel.common.avro",
  "type": "record",
  "name": "SentinelMetric",
  "fields": [
    { "name": "serviceId", "type": "string" },
    { "name": "metricName", "type": "string" },
    { "name": "value", "type": "double", "default": 0.0 },
    { "name": "timestamp", "type": "long", "default": 0 }
  ]
}
